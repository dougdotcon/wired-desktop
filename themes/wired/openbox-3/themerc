# wired — flat phosphor theme. no gradients, no pixmaps.
# lain crt green on a mission-control black. cheap to paint.

border.width: 1
padding.width: 4
padding.height: 2
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap.x: 0
menu.overlap.y: 0
menu.border.width: 1
menu.separator.width: 1
menu.separator.padding.width: 8
menu.separator.padding.height: 3
window.label.text.justify: left

window.active.border.color: #3dff9a
window.inactive.border.color: #1a2820
window.active.title.separator.color: #1f4d38
window.inactive.title.separator.color: #142018
menu.border.color: #1f4d38
menu.separator.color: #1c3328
border.color: #1a2820

window.active.title.bg: flat solid
window.active.title.bg.color: #070b09
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #070b09

window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative
window.active.label.text.color: #b8ffc9
window.inactive.label.text.color: #5a7264

window.active.client.color: #070b09
window.inactive.client.color: #070b09

window.*.button.*.bg: parentrelative
window.active.button.*.image.color: #9dffb0
window.inactive.button.*.image.color: #3d5246
window.active.button.disabled.image.color: #2a3a32
window.inactive.button.disabled.image.color: #24302a
window.active.button.*.hover.bg: flat solid
window.active.button.*.hover.bg.color: #143028
window.active.button.*.hover.image.color: #e8ffe8
window.active.button.*.pressed.bg: flat solid
window.active.button.*.pressed.bg.color: #1f4d38
window.active.button.*.pressed.image.color: #07140c
window.inactive.button.*.hover.bg: flat solid
window.inactive.button.*.hover.bg.color: #101612
window.inactive.button.*.pressed.bg: flat solid
window.inactive.button.*.pressed.bg.color: #101612
window.active.button.close.unpressed.image.color: #e07a7a
window.active.button.close.hover.image.color: #ffb4b4

menu.title.bg: flat solid
menu.title.bg.color: #0c1410
menu.title.text.color: #9dffb0
menu.title.text.justify: left

menu.items.bg: flat solid
menu.items.bg.color: #070b09
menu.items.text.color: #c8f5d4
menu.items.disabled.text.color: #3d5246
menu.items.justify: left
menu.items.active.bg: flat solid
menu.items.active.bg.color: #143028
menu.items.active.text.color: #9dffb0
menu.items.active.disabled.text.color: #3d5246

osd.border.width: 1
osd.border.color: #1f4d38
osd.bg: flat solid
osd.bg.color: #070b09
osd.label.bg: parentrelative
osd.label.text.color: #c8f5d4
osd.hilight.bg: flat solid
osd.hilight.bg.color: #143028
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #101612
osd.button.unpressed.bg: flat solid
osd.button.unpressed.bg.color: #101612
osd.button.unpressed.image.color: #9dffb0
osd.button.pressed.bg: flat solid
osd.button.pressed.bg.color: #1f4d38
osd.button.pressed.image.color: #07140c
osd.button.hover.bg: flat solid
osd.button.hover.bg.color: #143028
osd.button.hover.image.color: #e8ffe8
