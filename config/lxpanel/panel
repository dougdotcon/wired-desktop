# lxpanel <profile> config file. Manually editing is not recommended.
# Use preference dialog in lxpanel to adjust config when you can.

Global {
  edge=top
  align=left
  margin=0
  widthtype=percent
  width=100
  height=24
  transparent=0
  tintcolor=#070b09
  alpha=255
  setdocktype=1
  setpartialstrut=1
  autohide=0
  usefontcolor=1
  fontcolor=#9dffb0
  background=1
}
Plugin {
  type=menu
  Config {
    system {
    }
    separator {
    }
    item {
      command=run
    }
    separator {
    }
    item {
      command=logout
      image=/home/dougdotcon/.local/share/icons/wired/22/power.png
    }
    image=/home/dougdotcon/.local/share/icons/wired/22/menu.png
  }
}
Plugin {
  type=separator
  Config {
  }
}
Plugin {
  type=taskbar
  Config {
    tooltips=1
    IconsOnly=1
    AcceptSkipPager=1
    ShowIconified=1
    ShowMapped=1
    UseMouseWheel=1
    UseUrgencyHint=1
    FlatButton=1
    GroupedTasks=1
    MaxWidth=180
  }
}
Plugin {
  type=separator
  Config {
  }
}
Plugin {
  type=cpu
  Config {
  }
}
Plugin {
  type=thermal
  Config {
    NormalColor=#9dffb0
    Warning1Color=#c4a15a
    Warning2Color=#e07a7a
    AutomaticLevels=0
    Warning1Temp=75
    Warning2Temp=80
    AutomaticSensor=1
  }
}
Plugin {
  type=volume
  Config {
    MixerCommand=pavucontrol
    MixerCommandTerm=0
  }
}
Plugin {
  type=tray
  Config {
  }
}
Plugin {
  type=dclock
  Config {
    ClockFmt=%H:%M
    TooltipFmt=%A, %d %b
    BoldFont=0
    IconOnly=0
    CenterText=0
  }
}
